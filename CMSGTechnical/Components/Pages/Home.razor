@page "/"
@using CMSGTechnical.Code
@using CMSGTechnical.Domain.Models
@using CMSGTechnical.Mediator.Menu
@using MediatR
@using CMSGTechnical.Components.Shared
@using CMSGTechnical.Mediator.Dtos

<PageTitle>Home</PageTitle>



@foreach (var categoryGroup in MenuItems.GroupBy(m => m.Category).OrderBy(g => GetCategoryOrder(g.Key)))
{
    <div class="mb-4">
        <h3 class="mb-2"><strong>@categoryGroup.Key</strong></h3>
        @foreach (var item in categoryGroup)
        {
            <MenuItemDisplay Item="@item" OnAdd="AddItem" />
        }
    </div>
}



@code
{
    [Inject] private IMediator Mediator { get; set; } = default!;


    private MenuItemDto[] MenuItems { get; set; } = Array.Empty<MenuItemDto>();
    [CascadingParameter]
    private BasketService Basket { get; set; }


    protected override async Task OnInitializedAsync()
    {
        MenuItems = (await Mediator.Send(new GetMenuItems())).ToArray();
    }

    private async Task AddItem(MenuItemDto item)
    {
        await Basket.Add(item);
    }

    private int GetCategoryOrder(string category)
    {
        return category switch
        {
            "Starter" => 1,
            "Main" => 2,
            "Dessert" => 3,
            _ => 99
        };
    }
    
}
