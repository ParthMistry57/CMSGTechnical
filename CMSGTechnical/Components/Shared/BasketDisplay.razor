@using CMSGTechnical.Code
@using CMSGTechnical.Domain.Models
@using CMSGTechnical.Mediator.Basket
@using CMSGTechnical.Mediator.Dtos
@using MediatR

<div class="basket">
    
    @foreach (var basketItem in Basket.BasketItems)
    {
        <div class="basket-item">
            <div class="basket-item-name">
                @basketItem.MenuItem.Name - £@basketItem.MenuItem.Price.ToString("F2") x @basketItem.Quantity
            </div>
            
            <div class="basket-item-actions">
                <button class="btn btn-primary btn-round" @onclick="() => AddItem(basketItem.MenuItem)">+</button>
                <button class="btn btn-primary btn-round" @onclick="() => Remove(basketItem.MenuItem)">-</button>
            </div>
        </div>
    }
    
    <div class="basket-total">
        @{
            var subtotal = CalculateSubtotal();
            var deliveryFee = 2.00m;
            var total = subtotal + deliveryFee;
        }
        <div>Subtotal: £@subtotal.ToString("F2")</div>
        <div>Delivery: £@deliveryFee.ToString("F2")</div>
        <div><strong>Total: £@total.ToString("F2")</strong></div>
    </div>
</div>


@code {



    [Inject] private IMediator Mediator { get; set; } = default!;

    [CascadingParameter]
    private BasketService BasketService { get; set; }

    private BasketDto Basket => BasketService.Basket;

    protected override void OnInitialized()
    {
        BasketService.OnChange += (sender, args) => StateHasChanged();
    }


    private async Task AddItem(MenuItemDto item)
    {
        await BasketService.Add(item);
    }

    private async Task Remove(MenuItemDto item)
    {
        await BasketService.Remove(item);
    }

    private decimal CalculateSubtotal()
    {
        return Basket.BasketItems.Sum(bi => bi.MenuItem.Price * bi.Quantity);
    }

}
